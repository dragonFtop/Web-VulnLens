# DeepSeek API（OpenAI 兼容）—— 也可切换到本地 Ollama
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.1
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2
LLM_JSON_MODE=true

MAX_UPLOAD_MB=1
MAX_HTTP_BODY_KB=256
MAX_LLM_CODE_CHARS=24000
MAX_CANDIDATES=20
KB_TOP_K=3

REPAIR_ENABLED=true
REPAIR_MAX_FILE_KB=100
REPAIR_VERIFY_LLM=true
DEMO_CACHE=true
GUARD_RECHECK=true

DB_PATH=storage/app.db
LOG_LEVEL=INFO
